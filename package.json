{
  "name": "netword_sharing",
  "version": "1.0.0",
  "private": true,
  "description": "Share files, text, and links instantly across your local network.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "geist": "^1.9.1",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.10.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
