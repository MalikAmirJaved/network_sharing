# ---------------------------------------------------------------------------
# Netword configuration
# Copy to .env.local (or export these variables) and restart the server.
# ---------------------------------------------------------------------------

# Port and interface to bind. 0.0.0.0 makes the app reachable on your LAN.
PORT=3000
HOST=0.0.0.0

# Where SQLite + uploaded files live. Relative paths resolve from the repo root.
DATA_DIR=./data

# Signing secret for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If omitted, a secret is generated and persisted in DATA_DIR/.session-secret.
SESSION_SECRET=

# Default room lifetime in hours. 0 = rooms never expire.
ROOM_TTL_HOURS=24

# Per-file limit in bytes. 0 = unlimited.
MAX_UPLOAD_BYTES=0

# Per-room storage limit in bytes. 0 = unlimited.
ROOM_QUOTA_BYTES=0

# Max characters in a shared text note.
TEXT_MAX_CHARS=200000

# How often expired rooms are swept (minutes).
CLEANUP_INTERVAL_MINUTES=10

# Set to 1 when running behind a trusted reverse proxy (nginx, Caddy, Traefik).
TRUST_PROXY=0

# Set to true only when served over HTTPS. Leave false for plain LAN HTTP,
# otherwise browsers will refuse to send the session cookie.
COOKIE_SECURE=false

# Extra allowed origins for browser mutations, comma separated.
# Example: https://share.example.com,http://192.168.1.10:3000
ALLOWED_ORIGINS=

# Log every HTTP request (useful for debugging, noisy in production).
LOG_REQUESTS=0
